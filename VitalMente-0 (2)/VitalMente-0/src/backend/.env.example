# Copie para ".env" (src/backend/.env) e preencha. Nunca versione o .env real.

# --- SQL Server (obrigatório) ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=vitalmente
DB_USER=sa
DB_PASSWORD=@ITB123456
# DB_ENCRYPT=false        # true para Azure SQL / serviços gerenciados com TLS
# DB_TRUST_SERVER_CERT=true # true para desenvolvimento local com certificado auto-assinado
# DB_POOL_SIZE=10

# --- Servidor ---
PORT=3000
NODE_ENV=development     # em produção: production

# --- Segurança / sessão ---
# Origens do site autorizadas a chamar a API (separe por vírgula).
CORS_ORIGIN=http://localhost:5173
SESSION_DAYS=7
# COOKIE_SAMESITE=lax    # "none" só se site e API estiverem em domínios diferentes (exige HTTPS)
# COOKIE_SECURE=true     # padrão: true quando NODE_ENV=production
# TRUST_PROXY=true       # ligue se estiver atrás de proxy/hospedagem (Nginx, Render, etc.)

# --- Produção em um servidor só ---
# SERVE_FRONTEND=true    # Express entrega a pasta dist (npm run build)
